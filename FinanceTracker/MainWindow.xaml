<Window x:Class="FinanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:FinanceTracker.Models"
        mc:Ignorable="d"
        Title="Finance Tracker"
        Height="760"
        Width="900"
        MinHeight="620"
        MinWidth="720"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6B7A" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40">
            <Border Background="White"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32">
                <StackPanel>
                    <TextBlock Text="Finance Tracker"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#111827" />

                    <Grid Width="245"
                          HorizontalAlignment="Left"
                          Margin="0,28,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Balance"
                                   Style="{StaticResource SummaryLabelStyle}" />
                        <TextBlock x:Name="BalanceTextBlock"
                                   Grid.Row="0"
                                   Grid.Column="2"
                                   Style="{StaticResource SummaryValueStyle}" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Income"
                                   Style="{StaticResource SummaryLabelStyle}" />
                        <TextBlock x:Name="IncomeTextBlock"
                                   Grid.Row="1"
                                   Grid.Column="2"
                                   Style="{StaticResource SummaryValueStyle}" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Expenses"
                                   Style="{StaticResource SummaryLabelStyle}" />
                        <TextBlock x:Name="ExpensesTextBlock"
                                   Grid.Row="2"
                                   Grid.Column="2"
                                   Style="{StaticResource SummaryValueStyle}" />
                    </Grid>

                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Income vs Expenses"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   VerticalAlignment="Center" />

                        <ComboBox x:Name="ChartPeriodComboBox"
                                  Grid.Column="1"
                                  Width="135"
                                  Height="32"
                                  SelectedIndex="1"
                                  SelectionChanged="ChartPeriodComboBox_SelectionChanged">
                            <ComboBoxItem Content="Last 7 days"
                                          Tag="7" />
                            <ComboBoxItem Content="Last 30 days"
                                          Tag="30" />
                            <ComboBoxItem Content="Last 90 days"
                                          Tag="90" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Border BorderBrush="#D8DEE8"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="#FAFBFC" />
                        <Canvas x:Name="ChartCanvas"
                                Height="190"
                                ClipToBounds="True"
                                SizeChanged="ChartCanvas_SizeChanged" />
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,18,0">
                            <Rectangle Width="20"
                                       Height="3"
                                       Fill="#16A34A"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0" />
                            <TextBlock Text="Income"
                                       Foreground="#5F6B7A"
                                       FontSize="13" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20"
                                       Height="3"
                                       Fill="#DC2626"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0" />
                            <TextBlock Text="Expenses"
                                       Foreground="#5F6B7A"
                                       FontSize="13" />
                        </StackPanel>
                    </StackPanel>

                    <Button Content="+ Add Transaction"
                            HorizontalAlignment="Left"
                            Margin="0,28,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddTransactionButton_Click" />

                    <TextBlock Text="Recent Transactions"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0,30,0,0" />

                    <Border Height="1"
                            Width="470"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,12"
                            Background="#D8DEE8" />

                    <ListView x:Name="TransactionsListView"
                              Width="470"
                              MaxHeight="175"
                              HorizontalAlignment="Left"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Transaction}">
                                <Grid MinHeight="34"
                                      Width="440">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="205" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="105" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontSize="15"
                                               Foreground="#1F2937"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AmountText}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#DC2626" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:TransactionType.Income}">
                                                        <Setter Property="Foreground" Value="#16A34A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DateText}"
                                               FontSize="14"
                                               Foreground="#5F6B7A"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
