<Window x:Class="FinanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:FinanceTracker.Models"
        mc:Ignorable="d"
        Title="Finance Tracker"
        Height="790"
        Width="960"
        MinHeight="680"
        MinWidth="780"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="38" Width="862">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Finance Tracker"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Dashboard"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="+ Add Transaction"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddTransactionButton_Click" />
                    <Button Content="Reset Data"
                            Margin="12,0,0,0"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="ResetDataButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,14,0"
                        Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Balance"
                                   Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="BalanceTextBlock"
                                   Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="7,0,7,0"
                        Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Income"
                                   Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="IncomeTextBlock"
                                   Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Margin="14,0,0,0"
                        Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Expenses"
                                   Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="ExpensesTextBlock"
                                   Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Margin="0,24,0,0"
                    Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Income vs Expenses"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <ComboBox x:Name="ChartPeriodComboBox"
                                  Grid.Column="1"
                                  Width="150"
                                  Style="{StaticResource RoundedComboBoxStyle}"
                                  SelectedIndex="1"
                                  SelectionChanged="ChartPeriodComboBox_SelectionChanged">
                            <ComboBoxItem Content="Last 7 days"
                                          Tag="7" />
                            <ComboBoxItem Content="Last 30 days"
                                          Tag="30" />
                            <ComboBoxItem Content="Last 90 days"
                                          Tag="90" />
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="{StaticResource MutedCardBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14">
                        <Canvas x:Name="ChartCanvas"
                                Height="230"
                                ClipToBounds="True"
                                SizeChanged="ChartCanvas_SizeChanged" />
                    </Border>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,20,0">
                            <Rectangle Width="22"
                                       Height="4"
                                       Fill="{StaticResource IncomeBrush}"
                                       RadiusX="2"
                                       RadiusY="2"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="Income"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="22"
                                       Height="4"
                                       Fill="{StaticResource ExpenseBrush}"
                                       RadiusX="2"
                                       RadiusY="2"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="Expenses"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Margin="0,24,0,0"
                    Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Recent Transactions"
                               Style="{StaticResource SectionTitleStyle}" />

                    <ListView x:Name="TransactionsListView"
                              Grid.Row="2"
                              MaxHeight="210"
                              BorderThickness="0"
                              Background="Transparent"
                              ItemContainerStyle="{StaticResource TransactionListItemStyle}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Transaction}">
                                <Grid MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontSize="15"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AmountText}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:TransactionType.Income}">
                                                        <Setter Property="Foreground" Value="{StaticResource IncomeBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DateText}"
                                               FontSize="14"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
