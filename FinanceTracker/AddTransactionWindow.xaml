<Window x:Class="FinanceTracker.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Transaction"
        Width="440"
        SizeToContent="Height"
        MinHeight="470"
        MinWidth="440"
        Icon="Assets/AppIcon.ico"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Border Style="{StaticResource SectionCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Add Transaction"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="1"
                                          Direction="0"
                                          Opacity="0.18"
                                          ShadowDepth="0"
                                          Color="#0F172A" />
                    </TextBlock.Effect>
                </TextBlock>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Title"
                               Style="{StaticResource StatLabelStyle}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="TitleTextBox"
                             Style="{StaticResource RoundedTextBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="Amount"
                               Style="{StaticResource StatLabelStyle}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="AmountTextBox"
                             Style="{StaticResource RoundedTextBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="6">
                    <TextBlock Text="Type"
                               Style="{StaticResource StatLabelStyle}"
                               Margin="0,0,0,6" />
                    <ComboBox x:Name="TypeComboBox"
                              Style="{StaticResource RoundedComboBoxStyle}"
                              SelectedIndex="1">
                        <ComboBoxItem Content="Income" />
                        <ComboBoxItem Content="Expense" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="8">
                    <TextBlock Text="Date"
                               Style="{StaticResource StatLabelStyle}"
                               Margin="0,0,0,6" />
                    <DatePicker x:Name="DatePicker"
                                Height="46"
                                Padding="12,0"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}"
                                VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="10"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Width="92"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click" />
                    <Button Content="Save"
                            Width="92"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
